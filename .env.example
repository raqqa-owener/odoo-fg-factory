# odoo-fg-factory local development
PROJECT_NAME=odoo-fg-factory
APP_ENV=dev
TZ=Asia/Tokyo

# Ports: chosen to avoid the existing decikg-odoo-factory ports where possible
FG_API_PORT=18181
FG_CONSOLE_PORT=5179
FG_POSTGRES_PORT=15532
FG_NEO4J_HTTP_PORT=18474
FG_NEO4J_BOLT_PORT=18687
FG_ODOO_PORT=18069
FG_ODOO_LONGPOLLING_PORT=18072
FG_PGADMIN_PORT=15180

# Postgres for FG Factory metadata
FG_POSTGRES_DB=fg_factory
FG_POSTGRES_USER=dev
FG_POSTGRES_PASSWORD=dev
FG_DATABASE_URL=postgresql+psycopg2://dev:dev@fg-postgres:5432/fg_factory

# Neo4j
NEO4J_AUTH=neo4j/password
NEO4J_URI=bolt://fg-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_APPLY_ENABLED=false

# Odoo demo runtime
# Change to odoo:18.0 if the local Docker environment cannot pull/use odoo:19.0.
ODOO_IMAGE=odoo:19.0
FG_ODOO_DB_HOST=fg-odoo-db
FG_ODOO_DB_PORT=5432
FG_ODOO_DB_NAME=odoo_fg_demo
FG_ODOO_DB_USER=odoo
FG_ODOO_DB_PASSWORD=odoo
# Console
VITE_API_BASE_URL=http://localhost:18181
# The distributable public edition uses its built-in lightweight graph preview.
VITE_USE_YFILES_CANVAS=false

# OpenAI is intentionally not used by this system runtime.
# ChatGPT creates JSON outside the system; this system only imports/normalizes/applies it.
OPENAI_API_KEY=
